# --- Security ---
# Comma-separated API keys allowed to call the alert API (X-API-Key header)
ALERT_API_KEYS=dev-key-123
# true: every /api/* endpoint requires X-API-Key (recommended)
REQUIRE_AUTH=true

# --- Database (defaults to a local SQLite file) ---
# DATABASE_URL=sqlite:///./alerts.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/alerts

# --- Optional threat-intel enrichment keys ---
# VT_API_KEY=
# ABUSEIPDB_API_KEY=